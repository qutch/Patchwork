"""Contract test: every golden sink body must satisfy the destination's request schema.

Uses $PATCHWORK_SINK_OPENAPI (the destination's *current* /openapi.json, set by preflight
and the control plane) when present, else the snapshot taken at compile time."""

import json
import os
from pathlib import Path

import pytest

from runner.contract import validate_body

from .conftest import PKG, golden_cases

SINK_CALL = ({{ sink_call.method|py }}, {{ sink_call.path|py }})


def _openapi():
    path = os.environ.get("PATCHWORK_SINK_OPENAPI") or PKG / "contract" / "openapi.json"
    if not Path(path).exists():
        pytest.skip("no destination OpenAPI available")
    return json.loads(Path(path).read_text())


@golden_cases("body")
def test_body_matches_destination_contract(example):
    errors = validate_body(_openapi(), *SINK_CALL, example["expect"]["body"])
    assert errors == []
{% if has_rows %}


@golden_cases("rows")
def test_row_bodies_match_destination_contract(example):
    errors = [e for body in example["expect"]["rows"] for e in validate_body(_openapi(), *SINK_CALL, body)]
    assert errors == []
{% endif %}
