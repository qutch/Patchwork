def validate_document(fields: dict, rows: list) -> None:
    """Cross-check rules over the document's rows (contracts V18), before any row is validated or written."""
    for rule in CROSS_RULES:
        problem = check_cross(rule, fields, rows)
        if problem:
            raise Quarantine("VALIDATION_FAILED", problem)
    return None
{% endif %}


def dedupe_key(fields: dict, record: dict) -> str:
    return "|".join(str(lookup_ref(k, fields, record)) for k in DEDUPE_KEY)


